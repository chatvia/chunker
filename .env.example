# --- Server -------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# MAX_UPLOAD_MB=50

# Require `Authorization: Bearer <API_KEY>` on every /v1 endpoint (recommended in production).
API_KEY=

# --- Embeddings -----------------------------------------------------------------
# Any OpenAI-compatible /embeddings API. Needed for semantic chunking, `embed: true` and /v1/embed.
#   OpenAI:  EMBEDDINGS_BASE_URL=https://api.openai.com/v1   EMBEDDINGS_MODEL=text-embedding-3-small
#   Mistral: EMBEDDINGS_BASE_URL=https://api.mistral.ai/v1   EMBEDDINGS_MODEL=mistral-embed
#   Ollama:  EMBEDDINGS_BASE_URL=http://localhost:11434/v1  EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# EMBEDDINGS_DIMENSIONS=
# EMBEDDINGS_BATCH_SIZE=64
# EMBEDDINGS_TIMEOUT=60
# EMBEDDINGS_MAX_RETRIES=2

# --- Webhooks -------------------------------------------------------------------
# Signing secret for asynchronous jobs (`webhook_url`), per the Standard Webhooks spec.
# Generate one with: echo "whsec_$(openssl rand -base64 32)"
WEBHOOK_SECRET=
# WEBHOOK_TIMEOUT=30
# WEBHOOK_MAX_ATTEMPTS=3
# Set to false only for local receivers with self-signed certificates.
# WEBHOOK_VERIFY_TLS=true
